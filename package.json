{
  "name": "@vistta/js-native",
  "version": "0.0.0",
  "description": "Vistta.js native app runtime for Android and desktop platforms using Tauri",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./plugins": "./plugins/index.js"
  },
  "type": "module",
  "files": [
    "index.js",
    "plugins.config.js",
    "patches",
    "plugins",
    "utils",
    "rust/build.rs",
    "rust/Cargo.toml",
    "rust/tauri.conf.json",
    "rust/capabilities/*.json",
    "rust/src/*.rs",
    "rust/plugins/*/build.rs",
    "rust/plugins/*/Cargo.toml",
    "rust/plugins/*/src/**",
    "rust/plugins/*/permissions/**",
    "rust/plugins/*/android/*.kts",
    "rust/plugins/*/android/*.pro",
    "rust/plugins/*/android/src/**",
    "tests"
  ],
  "scripts": {
    "postinstall": "",
    "test": "node --test tests/*.test.js",
    "tests": "npm test",
    "test:package": "node tests/consumer-smoke.js",
    "test:native": "node tests/consumer-smoke.js --native"
  },
  "repository": {
    "type": "git",
    "url": "https://git.vistta.org/vistta/js-native.git"
  },
  "author": "Tiago Terenas Almeida",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/cli": "2.12.1",
    "@tauri-apps/plugin-barcode-scanner": "^2.5.3",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-haptics": "^2.4.1",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "@tauri-apps/plugin-shell": "^2.4.0",
    "@vistta/fs": "^1.1.0",
    "@vistta/utils": "^1.1.0",
    "tauri-plugin-audio-recorder-api": "^0.1.2"
  },
  "peerDependencies": {
    "@vistta/js": ">=0.0.1",
    "sharp": "^0.35.5",
    "socket.io-client": "^4.8.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}