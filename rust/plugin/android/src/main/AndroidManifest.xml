<manifest 
    
    xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <application>
        <service
            android:name="org.vistta.runtime.VisttaService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keep app process and webview alive for user-scheduled background timers and persistent socket connections." />
        </service>
        <!--
            AccessibilityService used *only* to obtain the background
            clipboard-read privilege that Android 10+ reserves for the
            foreground app, the default IME, or an enabled
            AccessibilityService. It does not observe accessibility events
            or touch the UI tree (see res/xml/vistta_accessibility_config.xml).
            The user must enable it manually under Settings → Accessibility;
            it cannot be granted programmatically.
        -->
        <service
            android:name="org.vistta.runtime.VisttaAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/vistta_accessibility_config" />
        </service>
    </application>
</manifest>